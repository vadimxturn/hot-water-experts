# Hot Water Experts environment.
# Copy to .env.local. Every integration runs in demo mode when its keys are empty.

# Signed staff session cookie. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Shared password for the seeded demo staff accounts.
# Demo emails: admin@hotwaterexperts.demo, office@hotwaterexperts.demo,
# permits@hotwaterexperts.demo, tech.a@hotwaterexperts.demo,
# tech.b@hotwaterexperts.demo, tech.c@hotwaterexperts.demo
DEMO_PASSWORD=demo

# Postgres connection (Supabase or any Postgres). Leave empty to use the
# on-disk demo store (data/store.json locally, memory or /tmp on Vercel).
# Example: postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Stripe. Deposit is $100 (10000 cents). Leave empty to record a stub payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio SMS. Leave empty to log texts on the job instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# GoHighLevel. When set, new and booked leads POST JSON to this webhook.
GHL_WEBHOOK_URL=
GHL_API_KEY=
GHL_LOCATION_ID=

# Google Maps / Routes. Leave empty to show the sample map and a distance estimate.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional email provider. Job summary email is recorded, not sent, until this is set.
RESEND_API_KEY=
EMAIL_FROM=
